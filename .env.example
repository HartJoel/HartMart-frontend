# Copy to .env.local and adjust. Vite exposes only VITE_-prefixed variables.
# Origin only, no trailing path — each feature's api.ts appends its own version
# prefix (most modules use /v1, Auth currently uses /api/v1, see docs §3).
# Leave VITE_API_URL empty to use same-origin requests (e.g. behind a proxy).
VITE_API_URL=http://localhost:5001
